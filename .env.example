# 复制为 .env.local 后填写（.env.local 已被 git 忽略，切勿提交 Key）

# ---- 数据与存储 ----
DATABASE_URL=file:./data/app.db
STORAGE_DRIVER=local
PUBLIC_BASE_URL=http://localhost:3000

# ---- AI：真实模型开关 ----
# 默认全部 mock：不填 Key 也能走完整流程。启用真实模型只需在服务器的 .env.local 里：
#   文本：AI_TEXT_PROVIDER=openai-compat + OPENAI_COMPAT_API_KEY
#   图像：AI_IMAGE_PROVIDER=openai（或 zhipu）+ IMAGE_API_KEY（+ IMAGE_BASE_URL / IMAGE_MODEL）
# 启用后每次调用：超时 → 自动重试 1 次 → 仍失败（或 Key 为空）回退 mock，页面不会报错；
# 回退会在服务端日志打印 "[ai] … 回退 mock"。Key 只写在服务器上，切勿提交。

# ---- AI：文本（默认智谱 BigModel，OpenAI 兼容接口）----
# 覆盖：AI 目标推荐、人格卡 + 故事设定、13 章路线图与首周任务、第一封信、
#       周末采访问题、章节规划（分镜 / 下周任务）、章节正文、章末来信、照片与自拍描述
AI_TEXT_PROVIDER=mock
OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_COMPAT_API_KEY=
TEXT_MODEL_SMART=glm-5.3
TEXT_MODEL_FAST=glm-5.3-flash
TEXT_MODEL_VISION=glm-5.3-flash
# 目标推荐（POST /api/goal-suggestions）单独通道：auto=跟随 AI_TEXT_PROVIDER；
# real=全局 mock 时也走真实 API（只影响 suggestGoals 一个方法）；mock=强制模板
AI_SUGGEST_PROVIDER=auto

# ---- AI：图像 ----
# 覆盖：两张角色设定图、章节封面与下一章迷雾封面、每章 4 格分镜
# 三种模式：mock（占位图）/ zhipu（cogview）/ openai（OpenAI 兼容中转站，/images/generations）
# sidrune.ai 中转站已验证（2026-10-24）：AI_IMAGE_PROVIDER=openai + IMAGE_BASE_URL=https://sidrune.ai/v1，
# 可用模型 gpt-image-2 / gpt-image-2.5-flare / gpt-image-2.5-sunburst，返回 b64_json（PNG）
# zhipu 模式下 IMAGE_API_KEY 为空时复用 OPENAI_COMPAT_API_KEY
AI_IMAGE_PROVIDER=mock
IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_API_KEY=
IMAGE_MODEL=cogview-4-250304
IMAGE_CONCURRENCY=3

# ---- AI：超时（毫秒，单次尝试；失败后重试 1 次再回退 mock）----
# FAST：同步接口（目标推荐 / 采访问题 / 照片描述），2 次尝试要落在反向代理的 60s 内
AI_FAST_TIMEOUT_MS=25000
# 结构化生成（人格卡、路线图、章节规划），含一次格式修复
AI_TEXT_TIMEOUT_MS=90000
# 流式正文 / 来信（整段输出）
AI_STREAM_TIMEOUT_MS=120000
AI_IMAGE_TIMEOUT_MS=120000

# ---- 其他 ----
MOCK_LATENCY_MS=800
DEMO_MODE=1
# 路演：现场生成走预生成章节回放（不调用真实模型）；要用真实模型生成章节请保持 0
DEMO_CACHED_GENERATE=0
