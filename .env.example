# 复制为 .env.local 后填写（.env.local 已被 git 忽略，切勿提交 Key）

# ---- 数据与存储 ----
DATABASE_URL=file:./data/app.db
STORAGE_DRIVER=local
PUBLIC_BASE_URL=http://localhost:3000

# ---- AI：文本（智谱 BigModel，OpenAI 兼容接口）----
# 默认 mock：前端/后端开发不消耗额度。A 轨道调 prompt 时改为 openai-compat
AI_TEXT_PROVIDER=mock
OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_COMPAT_API_KEY=
TEXT_MODEL_SMART=glm-5.3
TEXT_MODEL_FAST=glm-5.3-flash
TEXT_MODEL_VISION=glm-5.3-flash
# 目标推荐（POST /api/goal-suggestions）单独通道：auto=跟随 AI_TEXT_PROVIDER；
# real=全局 mock 时也走真实 API（只影响 suggestGoals 一个方法，主流程仍 mock）；mock=强制模板
AI_SUGGEST_PROVIDER=auto

# ---- AI：图像 ----
# 三种模式：mock（占位图）/ zhipu（cogview）/ openai（OpenAI 兼容中转站，/images/generations）
# sidrune.ai 中转站已验证（2026-10-24）：AI_IMAGE_PROVIDER=openai + IMAGE_BASE_URL=https://sidrune.ai/v1，
# 可用模型 gpt-image-2 / gpt-image-2.5-flare / gpt-image-2.5-sunburst，返回 b64_json（PNG）
AI_IMAGE_PROVIDER=mock
IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_API_KEY=
IMAGE_MODEL=cogview-4-250304
IMAGE_CONCURRENCY=3

# ---- 其他 ----
MOCK_LATENCY_MS=800
DEMO_MODE=1
